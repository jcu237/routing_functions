diagramName = "npltrb";
R = QQ[α_1, α_2, α_3, α_4, α_5, s, M];

-- the first Symanzik polynomial at α_6 = 1
U = α_1*α_2+α_1*α_3+α_1*α_4+α_2*α_3+α_2*α_4+α_2*α_5+α_3*α_5+α_4*α_5+α_1+α_3+α_4+α_5;


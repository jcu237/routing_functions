-- The system has one more equation, y*α_1*α_2*α_3*α_4*α_5*U = 1, which says that no α_e
-- vanishes and neither does U. Macaulay2 saturates by these instead (see singular_locus.m2).
alphaVariables = {α_1, α_2, α_3, α_4, α_5};

